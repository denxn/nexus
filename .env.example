# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
APP_PASSWORD="choose-a-long-password"
SESSION_SECRET="generate-with: openssl rand -base64 32"

# Optional: a direct (non-pooled) connection string used only for migrations.
# On Neon, DATABASE_URL can be the pooled string and DIRECT_URL the direct one.
# DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional login throttling (defaults shown).
# LOGIN_MAX_ATTEMPTS=5        # failures per IP before a lockout
# LOGIN_GLOBAL_MAX=20         # failures across all IPs before everyone is locked out
# LOGIN_WINDOW_MINUTES=15     # window for counting failures, and the lockout length
