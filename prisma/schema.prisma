generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntryType {
  WORKOUT
  STUDY
  SLEEP
  MEAL
  MOOD
}

enum Source {
  MANUAL
  APPLE_HEALTH
  GOOGLE_CAL
}

enum Period {
  DAY
  WEEK
}

model Entry {
  id         String    @id @default(cuid())
  type       EntryType
  occurredAt DateTime
  value      Float
  label      String?
  meta       Json?
  source     Source    @default(MANUAL)
  externalId String?
  createdAt  DateTime  @default(now())

  @@unique([source, externalId])
  @@index([occurredAt])
}

model Target {
  id     String    @id @default(cuid())
  type   EntryType
  period Period
  value  Float

  @@unique([type, period])
}

enum GoalKind {
  MANUAL
  MEASURED
}

enum GoalStatus {
  ACTIVE
  DONE
  PAUSED
}

enum ProblemStatus {
  ACTIVE
  IMPROVING
  SOLVED
}

enum Repeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Goal {
  id           String      @id @default(cuid())
  title        String
  category     String?
  deadline     String? // day key YYYY-MM-DD (Rome)
  status       GoalStatus  @default(ACTIVE)
  kind         GoalKind
  progress     Int? // MANUAL: 0..100
  measuredType EntryType? // MEASURED
  targetValue  Float? // MEASURED, in Entry units
  startDate    String? // MEASURED, day key
  createdAt    DateTime    @default(now())
  todos        Todo[]
}

model Problem {
  id          String              @id @default(cuid())
  title       String
  trigger     String?
  counterPlan String?
  severity    Int
  status      ProblemStatus       @default(ACTIVE)
  createdAt   DateTime            @default(now())
  occurrences ProblemOccurrence[]
  todos       Todo[]
}

model ProblemOccurrence {
  id         String   @id @default(cuid())
  problemId  String
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  occurredAt DateTime
  note       String?

  @@index([problemId, occurredAt])
}

model Todo {
  id        String    @id @default(cuid())
  title     String
  dueDate   String? // day key
  priority  Priority  @default(MEDIUM)
  done      Boolean   @default(false)
  doneAt    DateTime?
  goalId    String?
  goal      Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  problemId String?
  problem   Problem?  @relation(fields: [problemId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  // Recurrence (see lib/recurrence): the due date is the anchor and rolls forward when ticked.
  repeat         Repeat  @default(NONE)
  repeatInterval Int     @default(1)
  repeatWeekdays Int[]    @default([])
  repeatUntil    String?
  repeatMonthDay Int?

  @@index([dueDate])
}

model Event {
  id         String    @id @default(cuid())
  title      String
  startsAt   DateTime
  endsAt     DateTime?
  source     Source    @default(MANUAL)
  externalId String?
  createdAt  DateTime  @default(now())

  // Recurrence: the series is stored once and expanded on read at the same Rome wall-clock time.
  repeat         Repeat   @default(NONE)
  repeatInterval Int      @default(1)
  repeatWeekdays Int[]    @default([])
  repeatUntil    String?
  skippedDays    String[] @default([])
  remindMinutes  Int?

  @@unique([source, externalId])
  @@index([startsAt])
}

model LoginAttempt {
  id String   @id @default(cuid())
  ip String
  at DateTime @default(now())

  @@index([at])
}

model Note {
  id        String   @id @default(cuid())
  day       String // day key YYYY-MM-DD (Rome)
  title     String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([day])
}
